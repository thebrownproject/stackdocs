# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo mode (optional, local interview demos)
# true: skip Clerk route protection and use SUPABASE_SERVICE_ROLE_KEY for server-side data queries
# false: normal auth-protected behavior
NEXT_PUBLIC_DEMO_MODE=false

# Clerk - Get from Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Supabase service role key (for webhook admin access - bypasses RLS)
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk webhook signing secret (for verifying webhook requests)
# Get from: Clerk Dashboard > Webhooks > Your endpoint > Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Anthropic - used by the Vercel AI SDK for document extraction (server-side)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Inbound email domain for the per-agent email-in stub (optional)
# Addresses are shown as doc-<token>@<this domain>.
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=inbound.trestle.dev

# Stripe billing (optional until paid checkout is enabled)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# Destination adapters (optional)
# Base64-encoded Google service account JSON or raw JSON string.
GOOGLE_SERVICE_ACCOUNT_KEY=...
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Trestle <deliveries@example.com>"
